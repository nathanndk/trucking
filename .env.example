# Copy to .env. Use an absolute, persistent directory in production.
DATA_DIR=./data
# Optional override. Defaults to DATA_DIR/app.db
# DATABASE_PATH=/var/lib/lintas/app.db
BETTER_AUTH_URL=http://localhost:4321
# Generate: openssl rand -base64 48
BETTER_AUTH_SECRET=
HOST=127.0.0.1
PORT=4321
# Only set true behind a trusted proxy that OVERWRITES X-Real-IP.
TRUST_PROXY=false
# For one-time bootstrap only. Remove password after use.
ADMIN_NAME=Website Administrator
ADMIN_EMAIL=
ADMIN_PASSWORD=
