# Copy to .env. Use an absolute, persistent directory in production.
DATA_DIR=./data
# Optional override. Defaults to DATA_DIR/app.db
# DATABASE_PATH=/var/lib/lintas/app.db
BETTER_AUTH_URL=http://localhost:4321
# Generate: openssl rand -base64 48
BETTER_AUTH_SECRET=
HOST=127.0.0.1
PORT=4321
# Only set true behind a trusted proxy that OVERWRITES X-Real-IP.
TRUST_PROXY=false
# For one-time bootstrap only. Remove password after use.
ADMIN_NAME=Website Administrator
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Quote request emails. Each request is emailed to QUOTE_MAIL_TO (reply goes to the customer)
# and the customer gets a confirmation. Use the SMTP account of the genesistransindo.com
# mailbox; MAIL_FROM must be an address on that domain. Test with: pnpm mail:test
SMTP_HOST=
SMTP_PORT=465
# true for port 465 (TLS), false for 587 (STARTTLS)
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
MAIL_FROM=
QUOTE_MAIL_TO=info@genesistransindo.com
# Local only: write emails as JSON files to MAIL_OUTBOX instead of sending them.
# MAIL_TRANSPORT=json
# MAIL_OUTBOX=./data/outbox
