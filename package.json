{
  "name": "lintas-logistics",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "node --env-file=.env node_modules/astro/bin/astro.mjs dev --host 127.0.0.1",
    "build": "astro build",
    "start": "node --env-file=.env dist/server/entry.mjs",
    "check": "astro check && tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node --env-file=.env --import tsx scripts/migrate.ts",
    "db:seed": "node --env-file=.env --import tsx scripts/seed.ts",
    "admin:bootstrap": "node --env-file=.env --import tsx scripts/bootstrap.ts",
    "media:prune": "node --env-file=.env --import tsx scripts/prune.ts",
    "backup": "node --env-file=.env --import tsx scripts/backup.ts",
    "test": "playwright test",
    "test:unit": "node --import tsx --test tests/unit.test.ts tests/maintenance.test.ts",
    "admin:reset": "node --env-file=.env --import tsx scripts/reset-admin.ts",
    "images:optimize": "node scripts/optimize-images.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@playwright/test": "^1.63.0",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.6.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "drizzle-kit": "^0.31.10",
    "prettier": "^3.9.8",
    "prettier-plugin-astro": "^1.0.1",
    "tsx": "^4.23.13",
    "typescript": "^6.0.3"
  },
  "dependencies": {
    "@astrojs/node": "^11.1.6",
    "@astrojs/react": "^6.0.6",
    "@fontsource-variable/manrope": "^5.3.0",
    "@fontsource/barlow-condensed": "^5.3.0",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-label": "^2.1.15",
    "@radix-ui/react-slot": "^1.3.3",
    "@tailwindcss/vite": "^4.3.3",
    "astro": "^7.3.3",
    "better-auth": "^1.7.5",
    "better-sqlite3": "^13.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.2",
    "gsap": "^3.15.0",
    "lucide-react": "^1.47.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-dropzone": "^20.1.2",
    "sharp": "^0.35.4",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "zod": "^4.6.5"
  },
  "packageManager": "pnpm@12.5.1"
}
