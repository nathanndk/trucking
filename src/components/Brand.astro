---
interface Props {
  name: string;
  logo?: string;
  href?: string;
  /** Accessible name of the link target, e.g. "Beranda". */
  label?: string;
}
const { name, logo, href = '/', label = 'Home' } = Astro.props;
---

<a href={href} class="brand" aria-label={`${name}, ${label}`}>
  {logo ? <img class="brand-logo" src={logo} alt="" /> : <span class="brand-word">{name}</span>}
</a>
