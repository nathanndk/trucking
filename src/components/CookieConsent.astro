<section id="cookie-banner" class="cookie-banner" aria-label="Persetujuan cookies" hidden>
  <div class="cookie-content">
    <h2>Cookies di website ini</h2>
    <p>
      Kami hanya menggunakan cookies yang diperlukan. Belum ada cookies analitik atau pemasaran,
      sehingga kedua pilihan di bawah hanya menggunakan cookies wajib.{' '}
      <a href="/cookies">Pelajari penggunaan cookies</a>.
    </p>
    <div class="cookie-actions">
      <button type="button" data-cookie-save="all">
        Terima semua
      </button>
      <button type="button" data-cookie-save="necessary">
        Hanya yang diperlukan
      </button>
      <button type="button" data-cookie-open>
        Pengaturan
      </button>
    </div>
  </div>
</section>
<dialog id="cookie-settings" aria-labelledby="cookie-title" aria-describedby="cookie-description">
  <div class="cookie-content">
    <h2 id="cookie-title">Pengaturan cookies</h2>
    <p id="cookie-description">
      Saat ini hanya cookies wajib yang digunakan. Pilihan ini tidak mengubah cookie yang diperlukan
      untuk login admin.
    </p>
    <dl>
      <div>
        <dt>
          Wajib <span>Selalu aktif</span>
        </dt>
        <dd>Menyimpan keputusan cookies dan mendukung sesi login admin saat Anda masuk.</dd>
      </div>
      <div>
        <dt>
          Analitik <span>Belum digunakan</span>
        </dt>
        <dd>Tidak ada cookies analitik yang dipasang.</dd>
      </div>
      <div>
        <dt>
          Pemasaran <span>Belum digunakan</span>
        </dt>
        <dd>Tidak ada cookies pemasaran yang dipasang.</dd>
      </div>
    </dl>
    <p>
      Keputusan disimpan selama 180 hari. <a href="/cookies">Informasi penggunaan cookies</a>.
    </p>
    <div class="cookie-actions">
      <button type="button" data-cookie-save="necessary">
        Simpan pengaturan
      </button>
      <button type="button" id="cookie-close" autofocus>
        Tutup
      </button>
    </div>
  </div>
</dialog>
<script>
  const name = 'lintas_cookie_consent';
  const version = 1;
  const lifetime = 180 * 24 * 60 * 60;
  const banner = document.querySelector<HTMLElement>('#cookie-banner')!;
  const dialog = document.querySelector<HTMLDialogElement>('#cookie-settings')!;
  const footerButton = document.querySelector<HTMLButtonElement>('#cookie-footer-open')!;
  let trigger: HTMLElement | null = null;
  function hasDecision() {
    try {
      const raw = document.cookie.split('; ').find((part) => part.startsWith(`${name}=`));
      if (!raw) return false;
      const value = JSON.parse(decodeURIComponent(raw.slice(name.length + 1)));
      return (
        value?.version === version &&
        ['all', 'necessary'].includes(value.choice) &&
        Number.isFinite(value.savedAt) &&
        value.savedAt <= Date.now() &&
        Date.now() - value.savedAt < lifetime * 1000
      );
    } catch {
      return false;
    }
  }
  banner.hidden = hasDecision();
  footerButton.hidden = false;
  document.querySelectorAll<HTMLButtonElement>('[data-cookie-open]').forEach((button) => {
    button.addEventListener('click', () => {
      trigger = button;
      dialog.showModal();
    });
  });
  document.querySelector('#cookie-close')!.addEventListener('click', () => dialog.close());
  dialog.addEventListener('keydown', (event) => {
    if (event.key !== 'Tab') return;
    const controls = dialog.querySelectorAll<HTMLElement>('a[href], button:not([disabled])');
    const first = controls[0];
    const last = controls[controls.length - 1];
    if (event.shiftKey && document.activeElement === first) {
      event.preventDefault();
      last?.focus();
    } else if (!event.shiftKey && document.activeElement === last) {
      event.preventDefault();
      first?.focus();
    }
  });
  dialog.addEventListener('close', () => {
    (trigger && !trigger.closest('[hidden]') ? trigger : footerButton).focus({
      preventScroll: true,
    });
  });
  document.querySelectorAll<HTMLButtonElement>('[data-cookie-save]').forEach((button) => {
    button.addEventListener('click', () => {
      const value = encodeURIComponent(
        JSON.stringify({ version, choice: button.dataset.cookieSave, savedAt: Date.now() }),
      );
      try {
        document.cookie = `${name}=${value}; Max-Age=${lifetime}; Path=/; SameSite=Lax${location.protocol === 'https:' ? '; Secure' : ''}`;
      } catch {
        /* The current page remains usable when cookies are blocked. */
      }
      const focusInBanner = banner.contains(document.activeElement);
      banner.hidden = true;
      if (dialog.open) dialog.close();
      else if (focusInBanner) footerButton.focus({ preventScroll: true });
    });
  });
</script>
<style>
  .cookie-banner {
    position: fixed;
    inset: auto 20px 20px;
    z-index: 100;
    max-width: 820px;
    margin-inline: auto;
    background: #f9faf6;
    color: var(--ink);
    border: 1px solid var(--border);
    box-shadow: 0 12px 48px #142b2826;
    max-height: calc(100dvh - 40px);
    overflow-y: auto;
  }
  .cookie-banner[hidden] {
    display: none;
  }
  .cookie-content {
    padding: 24px;
  }
  .cookie-content h2 {
    font-size: 32px;
  }
  .cookie-content p,
  dd {
    font-size: 14px;
    line-height: 1.7;
  }
  .cookie-content a {
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .cookie-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin-top: 18px;
  }
  button {
    padding: 12px 16px;
    border: 1px solid var(--primary);
    font-size: 14px;
    font-weight: 700;
    background: transparent;
    color: var(--primary);
  }
  button:first-child {
    background: var(--primary);
    color: white;
  }
  dialog {
    margin: auto;
    width: min(600px, calc(100% - 32px));
    max-height: calc(100dvh - 32px);
    overflow-y: auto;
    padding: 0;
    border: 1px solid var(--border);
    background: #f9faf6;
    color: var(--ink);
  }
  dialog::backdrop {
    background: #142b2899;
  }
  dl > div {
    padding: 16px 0;
    border-bottom: 1px solid var(--border);
  }
  dt {
    display: flex;
    justify-content: space-between;
    gap: 12px;
    font-weight: 700;
  }
  dt span {
    font-size: 12px;
    color: var(--muted-foreground);
  }
  dd {
    margin: 8px 0 0;
  }
  @media (max-width: 480px) {
    .cookie-banner {
      inset: auto 12px 12px;
      max-height: calc(100dvh - 24px);
    }
    .cookie-content {
      padding: 20px;
    }
    .cookie-actions {
      flex-direction: column;
    }
  }
</style>
