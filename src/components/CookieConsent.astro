---
import { buttonVariants } from './ui/button';
import { localePath, toLocale } from '../i18n';
import { ui } from '../lib/copy';
/**
 * Cookie consent: a banner until the visitor chooses, a settings dialog, and the footer's
 * "Cookie settings" button (#cookie-footer-open in the layout) to change the choice later. The
 * choice is kept for 180 days in the genesis_cookie_consent cookie. The site only uses required
 * cookies, so every choice keeps those and nothing else. Without JavaScript nothing is shown.
 * Wording comes from the dictionary (Page text → Shared), in the page's language.
 */
const locale = toLocale(Astro.currentLocale);
const t = ui(locale).consent;
const info = localePath(locale, '/cookies');
const primary = buttonVariants({ size: 'sm' });
const secondary = buttonVariants({ variant: 'outline', size: 'sm' });
---

<section id="cookie-banner" class="cookie-banner" aria-label={t.label} hidden>
  <div class="cookie-content">
    <h2>{t.heading}</h2>
    <p>
      {t.text} <a href={info}>{t.link}</a>.
    </p>
    <div class="cookie-actions">
      <button type="button" class={primary} data-cookie-save="all">
        {t.acceptAll}
      </button>
      <button type="button" class={secondary} data-cookie-save="necessary">
        {t.necessary}
      </button>
      <button type="button" class={secondary} data-cookie-open>
        {t.settings}
      </button>
    </div>
  </div>
</section>
<dialog
  id="cookie-settings"
  class="cookie-dialog"
  aria-labelledby="cookie-title"
  aria-describedby="cookie-description"
>
  <div class="cookie-content">
    <h2 id="cookie-title">{t.settingsTitle}</h2>
    <p id="cookie-description">{t.settingsText}</p>
    <dl>
      <div>
        <dt>
          {t.required} <span>{t.alwaysOn}</span>
        </dt>
        <dd>{t.requiredText}</dd>
      </div>
      <div>
        <dt>
          {t.analytics} <span>{t.unused}</span>
        </dt>
        <dd>{t.analyticsText}</dd>
      </div>
      <div>
        <dt>
          {t.marketing} <span>{t.unused}</span>
        </dt>
        <dd>{t.marketingText}</dd>
      </div>
    </dl>
    <p>
      {t.kept} <a href={info}>{t.link}</a>.
    </p>
    <div class="cookie-actions">
      <button type="button" class={primary} data-cookie-save="necessary">
        {t.save}
      </button>
      <button type="button" class={secondary} id="cookie-close" autofocus>
        {t.close}
      </button>
    </div>
  </div>
</dialog>
<script>
  const name = 'genesis_cookie_consent';
  const version = 1;
  const lifetime = 180 * 24 * 60 * 60;
  const banner = document.querySelector<HTMLElement>('#cookie-banner')!;
  const dialog = document.querySelector<HTMLDialogElement>('#cookie-settings')!;
  const footerButton = document.querySelector<HTMLButtonElement>('#cookie-footer-open')!;
  let trigger: HTMLElement | null = null;
  function hasDecision() {
    try {
      const raw = document.cookie.split('; ').find((part) => part.startsWith(`${name}=`));
      if (!raw) return false;
      const value = JSON.parse(decodeURIComponent(raw.slice(name.length + 1)));
      return (
        value?.version === version &&
        ['all', 'necessary'].includes(value.choice) &&
        Number.isFinite(value.savedAt) &&
        value.savedAt <= Date.now() &&
        Date.now() - value.savedAt < lifetime * 1000
      );
    } catch {
      return false;
    }
  }
  banner.hidden = hasDecision();
  footerButton.hidden = false;
  document.querySelectorAll<HTMLButtonElement>('[data-cookie-open]').forEach((button) => {
    button.addEventListener('click', () => {
      trigger = button;
      dialog.showModal();
    });
  });
  document.querySelector('#cookie-close')!.addEventListener('click', () => dialog.close());
  dialog.addEventListener('keydown', (event) => {
    if (event.key !== 'Tab') return;
    const controls = dialog.querySelectorAll<HTMLElement>('a[href], button:not([disabled])');
    const first = controls[0];
    const last = controls[controls.length - 1];
    if (event.shiftKey && document.activeElement === first) {
      event.preventDefault();
      last?.focus();
    } else if (!event.shiftKey && document.activeElement === last) {
      event.preventDefault();
      first?.focus();
    }
  });
  dialog.addEventListener('close', () => {
    (trigger && !trigger.closest('[hidden]') ? trigger : footerButton).focus({
      preventScroll: true,
    });
  });
  document.querySelectorAll<HTMLButtonElement>('[data-cookie-save]').forEach((button) => {
    button.addEventListener('click', () => {
      const value = encodeURIComponent(
        JSON.stringify({ version, choice: button.dataset.cookieSave, savedAt: Date.now() }),
      );
      try {
        document.cookie = `${name}=${value}; Max-Age=${lifetime}; Path=/; SameSite=Lax${location.protocol === 'https:' ? '; Secure' : ''}`;
      } catch {
        /* The current page remains usable when cookies are blocked. */
      }
      const focusInBanner = banner.contains(document.activeElement);
      banner.hidden = true;
      if (dialog.open) dialog.close();
      else if (focusInBanner) footerButton.focus({ preventScroll: true });
    });
  });
</script>
<style>
  .cookie-banner {
    position: fixed;
    inset: auto 20px 20px;
    z-index: 100;
    max-width: 760px;
    margin-inline: auto;
    max-height: calc(100dvh - 40px);
    overflow-y: auto;
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    background: var(--background);
    color: var(--foreground);
    box-shadow: 0 16px 40px -20px rgba(11, 37, 69, 0.5);
  }
  .cookie-banner[hidden] {
    display: none;
  }
  .cookie-content {
    padding: 20px 24px;
  }
  .cookie-content h2 {
    font-size: 18px;
    line-height: 1.3;
  }
  .cookie-content p,
  .cookie-dialog dd {
    margin-top: 6px;
    font-size: 14px;
    line-height: 1.6;
    color: var(--muted-foreground);
  }
  .cookie-content a {
    color: var(--foreground);
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .cookie-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-top: 16px;
  }
  .cookie-dialog {
    margin: auto;
    width: min(560px, calc(100% - 32px));
    max-height: calc(100dvh - 32px);
    overflow-y: auto;
    padding: 0;
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    background: var(--background);
    color: var(--foreground);
  }
  .cookie-dialog::backdrop {
    background: rgba(11, 37, 69, 0.55);
  }
  .cookie-dialog dl > div {
    padding: 14px 0;
    border-bottom: 1px solid var(--line);
  }
  .cookie-dialog dt {
    display: flex;
    justify-content: space-between;
    gap: 12px;
    font-weight: 600;
  }
  .cookie-dialog dt span {
    font-size: 12px;
    font-weight: 500;
    color: var(--muted-foreground);
  }
  @media (max-width: 480px) {
    .cookie-banner {
      inset: auto 12px 12px;
      max-height: calc(100dvh - 24px);
    }
    .cookie-content {
      padding: 18px;
    }
    .cookie-actions {
      flex-direction: column;
    }
  }
</style>
