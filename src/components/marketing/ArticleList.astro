---
import { AspectRatio } from '../ui/aspect-ratio';
import { Card, CardContent, CardDescription, CardHeader, CardTitle } from '../ui/card';
import type { ContentRecord } from '../../lib/content-config';
import { formatDate, localePath, toLocale } from '../../i18n';
const { items } = Astro.props as { items: ContentRecord[] };
const locale = toLocale(Astro.currentLocale);
---

<div class="article-list" data-motion="group">
  {items.map((item) => (
    <Card className="gap-4 overflow-hidden pt-0" data-motion-item>
      <AspectRatio ratio={16 / 10} className="overflow-hidden bg-muted">
        {item.image && (
          <img
            data-motion-photo
            class="photo"
            src={item.image}
            alt=""
            width="800"
            height="500"
            loading="lazy"
          />
        )}
      </AspectRatio>
      <CardHeader>
        <CardDescription>
          <time datetime={item.createdAt.toISOString()}>{formatDate(item.createdAt, locale)}</time>
        </CardDescription>
        <CardTitle>
          <h3>
            <a
              class="hover:text-primary hover:underline hover:underline-offset-4"
              href={localePath(locale, `/articles/${item.slug}`)}
            >
              {item.title}
            </a>
          </h3>
        </CardTitle>
      </CardHeader>
      {item.shortDescription && (
        <CardContent>
          <p class="text-[15px] text-muted-foreground">{item.shortDescription}</p>
        </CardContent>
      )}
    </Card>
  ))}
</div>
