---
import { AspectRatio } from '../ui/aspect-ratio';
import { buttonVariants } from '../ui/button';
import { localePath, toLocale, ui } from '../../i18n';
const { text } = Astro.props as { text: string };
const locale = toLocale(Astro.currentLocale);
const t = ui(locale);
---

<section class="cta-band dark">
  <div class="wrap">
    <div class="cta-copy">
      <h2>{t.cta.heading}</h2>
      <p>{t.cta.text}</p>
      <a
        href={localePath(locale, '/contact')}
        class={buttonVariants({ variant: 'secondary', size: 'lg' })}
      >
        {text}
      </a>
    </div>
    <div class="cta-photo">
      <AspectRatio ratio={16 / 9} className="md:h-full">
        <img
          class="photo"
          src="/images/genesis/cta-handshake-1280.webp"
          srcset="/images/genesis/cta-handshake-640.webp 640w, /images/genesis/cta-handshake-1280.webp 1280w"
          sizes="(max-width: 767px) 100vw, 45vw"
          alt={t.cta.imageAlt}
          width="1280"
          height="720"
          loading="lazy"
        />
      </AspectRatio>
    </div>
  </div>
</section>
