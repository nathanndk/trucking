---
import { localePath, toLocale, ui } from '../../i18n';
const { title, label, description } = Astro.props as {
  title: string;
  label: string;
  description: string;
};
const locale = toLocale(Astro.currentLocale);
const t = ui(locale);
---

<section class="page-hero">
  <div class="wrap">
    <nav class="breadcrumb" aria-label="Breadcrumb">
      <a href={localePath(locale, '/')}>{t.nav.home}</a>
      <span aria-hidden="true">/</span>
      <span aria-current="page">{label}</span>
    </nav>
    <h1>{title}</h1>
    <p>{description}</p>
  </div>
</section>
