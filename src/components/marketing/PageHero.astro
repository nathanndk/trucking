---
import {
  Breadcrumb,
  BreadcrumbItem,
  BreadcrumbLink,
  BreadcrumbList,
  BreadcrumbPage,
  BreadcrumbSeparator,
} from '../ui/breadcrumb';
import { localePath, toLocale } from '../../i18n';
import { ui } from '../../lib/copy';
const { title, label, description } = Astro.props as {
  title: string;
  label: string;
  description: string;
};
const locale = toLocale(Astro.currentLocale);
const t = ui(locale);
---

<section class="page-hero">
  <div class="wrap">
    <Breadcrumb>
      <BreadcrumbList>
        <BreadcrumbItem>
          <BreadcrumbLink href={localePath(locale, '/')}>{t.nav.home}</BreadcrumbLink>
        </BreadcrumbItem>
        <BreadcrumbSeparator />
        <BreadcrumbItem>
          <BreadcrumbPage>{label}</BreadcrumbPage>
        </BreadcrumbItem>
      </BreadcrumbList>
    </Breadcrumb>
    <h1>{title}</h1>
    <p>{description}</p>
  </div>
</section>
