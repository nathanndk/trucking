---
import {
  Breadcrumb,
  BreadcrumbItem,
  BreadcrumbLink,
  BreadcrumbList,
  BreadcrumbPage,
  BreadcrumbSeparator,
} from '../ui/breadcrumb';
import { GridPattern } from '../ui/grid-pattern';
import { localePath, toLocale } from '../../i18n';
import { ui } from '../../lib/copy';
const { title, label, description } = Astro.props as {
  title: string;
  label: string;
  description: string;
};
const locale = toLocale(Astro.currentLocale);
const t = ui(locale);
---

<section class="page-hero">
  <GridPattern
    width={44}
    height={44}
    squares={[
      [19, 1],
      [22, 3],
      [24, 0],
      [26, 2],
      [29, 4],
    ]}
    className="fill-primary/10 stroke-foreground/10 [mask-image:linear-gradient(to_left,white,transparent_55%)]"
  />
  <div class="wrap">
    <Breadcrumb>
      <BreadcrumbList>
        <BreadcrumbItem>
          <BreadcrumbLink href={localePath(locale, '/')}>{t.nav.home}</BreadcrumbLink>
        </BreadcrumbItem>
        <BreadcrumbSeparator />
        <BreadcrumbItem>
          <BreadcrumbPage>{label}</BreadcrumbPage>
        </BreadcrumbItem>
      </BreadcrumbList>
    </Breadcrumb>
    <h1>{title}</h1>
    <p>{description}</p>
  </div>
</section>
