---
import { AspectRatio } from '../ui/aspect-ratio';
import { Card, CardContent, CardDescription, CardHeader, CardTitle } from '../ui/card';
import type { ContentRecord } from '../../lib/content-config';
import { fill, toLocale, ui } from '../../i18n';
const { items, full = false } = Astro.props as { items: ContentRecord[]; full?: boolean };
const t = ui(toLocale(Astro.currentLocale));
---

<div class="projects-grid" data-motion="group">
  {items.map((item) => (
    <Card className="gap-4 overflow-hidden pt-0" data-motion-item id={item.slug}>
      <AspectRatio ratio={17 / 10} className="overflow-hidden bg-muted">
        {item.image && (
          <img
            data-motion-photo
            class="photo"
            src={item.image}
            alt={fill(t.projects.imageAlt, { title: item.title })}
            width="800"
            height="470"
            loading="lazy"
          />
        )}
      </AspectRatio>
      <CardHeader>
        <CardTitle>
          <h3>{item.title}</h3>
        </CardTitle>
        <CardDescription>
          {[item.clientName, item.projectYear].filter(Boolean).join(', ')}
        </CardDescription>
      </CardHeader>
      <CardContent>
        <p class="text-[15px] whitespace-pre-line text-muted-foreground">
          {full ? item.description || item.shortDescription : item.shortDescription}
        </p>
      </CardContent>
    </Card>
  ))}
</div>
