---
import { Item, ItemContent, ItemDescription, ItemGroup, ItemMedia, ItemTitle } from '../ui/item';
import { toLocale, ui } from '../../i18n';
const t = ui(toLocale(Astro.currentLocale));
---

<section class="route" aria-labelledby="route-heading">
  <div class="wrap">
    <h2 id="route-heading" class="sr-only">
      {t.route.heading}
    </h2>
    <div class="route-track" data-motion="route">
      <svg class="route-line" viewBox="0 0 100 2" preserveAspectRatio="none" aria-hidden="true">
        <path data-motion-path d="M0 1H100"></path>
      </svg>
      <ItemGroup className="relative grid grid-cols-4 gap-6 max-md:grid-cols-1 max-md:gap-4">
        {t.route.stops.map((stop, i) => (
          <Item
            data-motion-marker
            className="flex-col items-start gap-3 p-0 max-md:flex-row max-md:flex-nowrap"
          >
            <ItemMedia
              variant="icon"
              className="route-num size-8 rounded-full border-2 border-foreground bg-background"
            >
              {i + 1}
            </ItemMedia>
            <ItemContent>
              <ItemTitle className="text-base font-semibold">{stop.title}</ItemTitle>
              <ItemDescription className="line-clamp-none text-[15px]">{stop.text}</ItemDescription>
            </ItemContent>
          </Item>
        ))}
      </ItemGroup>
    </div>
  </div>
</section>
