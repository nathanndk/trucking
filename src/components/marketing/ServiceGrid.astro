---
import { AspectRatio } from '../ui/aspect-ratio';
import { buttonVariants } from '../ui/button';
import { Card, CardDescription, CardFooter, CardHeader, CardTitle } from '../ui/card';
import Placeholder from './Placeholder.astro';
import type { ContentRecord } from '../../lib/content-config';
import { cn } from '../../lib/utils';
import { localePath, toLocale } from '../../i18n';
import { ui } from '../../lib/copy';
const { items } = Astro.props as { items: ContentRecord[] };
const locale = toLocale(Astro.currentLocale);
const t = ui(locale);
/** Bundled photos ship in two widths; uploaded media has a single file. */
const small = (image: string) => image.replace(/-1280\.webp$/, '-640.webp');
---

<div class="services-grid" data-motion="group">
  {items.map((item) => (
    <Card className="service-tile gap-4 overflow-hidden pt-0" data-motion-item id={item.slug}>
      <AspectRatio ratio={16 / 10} className="tile-photo overflow-hidden bg-muted">
        {item.image && (
          <img
            data-motion-photo
            class="photo"
            src={item.image}
            srcset={
              small(item.image) !== item.image
                ? `${small(item.image)} 640w, ${item.image} 1280w`
                : undefined
            }
            sizes={small(item.image) !== item.image ? '(max-width: 767px) 100vw, 50vw' : undefined}
            alt=""
            width="1280"
            height="800"
            loading="lazy"
          />
        )}
      </AspectRatio>
      <CardHeader>
        <CardTitle>
          <h3>{item.title}</h3>
        </CardTitle>
        <CardDescription className="text-[15px] whitespace-pre-line">
          {item.shortDescription}
        </CardDescription>
      </CardHeader>
      <CardFooter className="mt-auto">
        <a
          class={cn(buttonVariants({ variant: 'link' }), 'h-auto p-0')}
          href={`${localePath(locale, '/contact')}?service=${item.slug}`}
          aria-label={`${t.services.quoteShort}: ${item.title}`}
        >
          {t.services.quoteShort}
        </a>
      </CardFooter>
    </Card>
  ))}
</div>
{items.length === 0 && <Placeholder text={t.services.empty} />}
