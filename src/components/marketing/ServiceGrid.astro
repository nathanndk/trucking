---
import { buttonVariants } from '../ui/button';
import { Card, CardDescription, CardFooter, CardHeader, CardTitle } from '../ui/card';
import Placeholder from './Placeholder.astro';
import type { ContentRecord } from '../../lib/content-config';
import { cn } from '../../lib/utils';
import { localePath, toLocale } from '../../i18n';
import { ui } from '../../lib/copy';
const { items } = Astro.props as { items: ContentRecord[] };
const locale = toLocale(Astro.currentLocale);
const t = ui(locale);
/** Bundled photos ship in two widths; uploaded media has a single file. */
const small = (image: string) => image.replace(/-1280\.webp$/, '-640.webp');
---

<div class="services-grid">
  {items.map((item) => (
    <Card
      className="service-tile gap-4 overflow-hidden pt-0 max-sm:grid max-sm:grid-cols-[88px_minmax(0,1fr)] max-sm:items-start max-sm:gap-x-4 max-sm:gap-y-2 max-sm:p-4"
      id={item.slug}
    >
      {/* On phones each service is a compact row: a small square photo beside the text. */}
      <div class="tile-photo aspect-[16/10] overflow-hidden bg-muted max-sm:row-span-2 max-sm:aspect-square max-sm:rounded-md">
        {item.image && (
          <img
            class="photo"
            src={item.image}
            srcset={
              small(item.image) !== item.image
                ? `${small(item.image)} 640w, ${item.image} 1280w`
                : undefined
            }
            sizes={small(item.image) !== item.image ? '(max-width: 639px) 88px, 50vw' : undefined}
            alt=""
            width="1280"
            height="800"
            loading="lazy"
          />
        )}
      </div>
      <CardHeader className="max-sm:gap-1 max-sm:px-0">
        <CardTitle>
          <h3>{item.title}</h3>
        </CardTitle>
        <CardDescription className="text-[15px] whitespace-pre-line">
          {item.shortDescription}
        </CardDescription>
      </CardHeader>
      <CardFooter className="mt-auto max-sm:col-start-2 max-sm:px-0">
        <a
          class={cn(buttonVariants({ variant: 'link' }), 'h-auto p-0')}
          href={`${localePath(locale, '/contact')}?service=${item.slug}`}
          aria-label={`${t.services.quoteShort}: ${item.title}`}
        >
          {t.services.quoteShort}
        </a>
      </CardFooter>
    </Card>
  ))}
</div>
{items.length === 0 && <Placeholder text={t.services.empty} />}
