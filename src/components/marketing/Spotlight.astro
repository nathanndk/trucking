---
// Aceternity UI Spotlight, adapted to server-rendered Astro. See docs/credits.md.
---

<svg
  class="spotlight"
  xmlns="http://www.w3.org/2000/svg"
  viewBox="0 0 3787 2842"
  fill="none"
  aria-hidden="true"
>
  <g filter="url(#hero-spotlight)">
    <ellipse
      cx="1924.71"
      cy="273.501"
      rx="1924.71"
      ry="273.501"
      transform="matrix(-0.822377 -0.568943 -0.568943 0.822377 3631.88 2291.09)"
      fill="#c9f36a"
      fill-opacity="0.12"
    />
  </g>
  <defs>
    <filter
      id="hero-spotlight"
      x="0.860352"
      y="0.838989"
      width="3785.16"
      height="2840.26"
      filterUnits="userSpaceOnUse"
      color-interpolation-filters="sRGB"
    >
      <feFlood flood-opacity="0" result="BackgroundImageFix" />
      <feBlend mode="normal" in="SourceGraphic" in2="BackgroundImageFix" result="shape" />
      <feGaussianBlur stdDeviation="151" />
    </filter>
  </defs>
</svg>
<style>
  .spotlight {
    pointer-events: none;
    position: absolute;
    z-index: 1;
    top: -45%;
    left: -30%;
    height: 160%;
    width: 130%;
    opacity: 0;
    animation: spotlight 1.6s ease 0.2s forwards;
  }
  @keyframes spotlight {
    from {
      opacity: 0;
      transform: translate(-8%, -8%) scale(0.9);
    }
    to {
      opacity: 1;
      transform: translate(0, 0) scale(1);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .spotlight {
      opacity: 1;
      animation: none;
    }
  }
</style>
