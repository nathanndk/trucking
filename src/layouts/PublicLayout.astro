---
import '../styles/global.css';
import Brand from '../components/Brand.astro';
import SiteHeader from '../components/site/SiteHeader';
import { Badge } from '../components/ui/badge';
import { Separator } from '../components/ui/separator';
import { getPublicContent, getPublicSettings } from '../lib/repository';
import { origin } from '../lib/env';
import { locales, localePath, stripLocale, toLocale, type Locale } from '../i18n';
import { ui } from '../lib/copy';
// Headings use this file on first paint; preloading it avoids a flash of the fallback font.
import headingFont from '@fontsource-variable/archivo/files/archivo-latin-wdth-normal.woff2?url';
interface Props {
  title: string;
  description: string;
  /** Social sharing image. Defaults to the bundled port photo. */
  image?: string;
  /** Pages without a counterpart in the other language (the 404 page). */
  noAlternates?: boolean;
}
const { title, description, image = '/images/genesis/og.jpg', noAlternates = false } = Astro.props;
const locale = toLocale(Astro.currentLocale);
const t = ui(locale);
const s = getPublicSettings(locale);
const path = noAlternates ? '/' : stripLocale(Astro.url.pathname).path;
const href = (target: string) => localePath(locale, target);
const nav = [
  ['/', t.nav.home],
  ['/about', t.nav.about],
  ['/services', t.nav.services],
  ['/projects', t.nav.projects],
  ['/articles', t.nav.articles],
  ['/contact', t.nav.contact],
] as const;
const current = (target: string) =>
  !noAlternates && (path === target || (target !== '/' && path.startsWith(`${target}/`)))
    ? 'page'
    : undefined;
// The Services link in the header opens a panel with one entry per service.
const servicesMenu = {
  all: t.home.servicesAll,
  items: getPublicContent('services', locale).map((service) => ({
    href: `${href('/services')}#${service.slug}`,
    title: service.title,
    text: service.shortDescription,
  })),
};
const absolute = (target: string) => new URL(target, origin).href;
const canonical = absolute(localePath(locale, stripLocale(Astro.url.pathname).path));
const languages: Record<Locale, { code: string; name: string }> = {
  id: { code: 'ID', name: 'Bahasa Indonesia' },
  en: { code: 'EN', name: 'English' },
};
// Each page is written in its own language, so the <html translate="no"> attribute and the
// Google notranslate tag below stop browsers offering machine translation.
const pageTitle = `${title} | ${s.companyName}`;
const phoneHref = s.phone ? `tel:${s.phone.replace(/[^+\d]/g, '')}` : '';
const structured = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: s.legalName,
  url: origin,
  description: s.shortDescription,
  ...(s.logo ? { logo: absolute(s.logo) } : {}),
  ...(s.phone ? { telephone: s.phone } : {}),
  ...(s.email ? { email: s.email } : {}),
  ...(s.address ? { address: s.address } : {}),
}).replaceAll('<', '\\u003c');
---

<!doctype html>
<html lang={t.htmlLang} translate="no">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="google" content="notranslate" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    {noAlternates ? (
      <meta name="robots" content="noindex" />
    ) : (
      <>
        <link rel="canonical" href={canonical} />
        {locales.map((code) => (
          <link rel="alternate" hreflang={code} href={absolute(localePath(code, path))} />
        ))}
        <link rel="alternate" hreflang="x-default" href={absolute(localePath('id', path))} />
      </>
    )}
    <meta property="og:type" content="website" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={t.ogLocale} />
    <meta property="og:image" content={absolute(image)} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="theme-color" content="#0b2545" />
    <link rel="preload" as="font" type="font/woff2" href={headingFont} crossorigin />
    <link rel="icon" href={s.favicon || '/favicon.png'} />
    <script is:inline type="application/ld+json" set:html={structured}></script>
    <slot name="head" />
    <style is:global>
      /* Moving between public pages cross-fades instead of flashing white, and the header
         stays in place (.navbar has a view-transition-name). Browsers without cross-document
         view transitions simply load the page. */
      @view-transition {
        navigation: auto;
      }
      ::view-transition-old(root),
      ::view-transition-new(root) {
        animation-duration: 0.2s;
      }
      @media (prefers-reduced-motion: reduce) {
        @view-transition {
          navigation: none;
        }
      }
    </style>
  </head>
  <body class="marketing">
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:fixed focus:z-50 focus:bg-white focus:p-4"
    >
      {t.skip}
    </a>
    <SiteHeader
      client:idle
      brand={{ name: s.companyName, logo: s.logo, href: href('/'), label: t.nav.brandHome }}
      nav={nav.map(([target, label]) => ({
        href: href(target),
        label,
        current: current(target) === 'page',
        ...(target === '/services' ? { menu: servicesMenu } : {}),
      }))}
      languages={locales.map((code) => ({
        ...languages[code],
        locale: code,
        href: localePath(code, path),
        current: code === locale,
      }))}
      cta={{ href: href('/contact'), label: s.ctaText }}
      labels={{
        main: t.nav.main,
        open: t.nav.open,
        mobile: t.nav.mobile,
        language: t.nav.language,
      }}
    />
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <footer class="footer">
      <div class="wrap">
        <div class="footer-grid">
          <div class="footer-about">
            <Brand name={s.companyName} logo={s.logo} href={href('/')} label={t.nav.brandHome} />
            <p>{s.shortDescription}</p>
          </div>
          <div>
            <h2>{t.footer.explore}</h2>
            <ul>
              {nav.slice(1).map(([target, label]) => (
                <li>
                  <a href={href(target)}>{label}</a>
                </li>
              ))}
            </ul>
          </div>
          <div>
            <h2>{t.footer.contact}</h2>
            <ul class="footer-contact">
              <li>
                <span>{t.footer.whatsapp}</span>
                {s.whatsapp ? (
                  <a href={`https://wa.me/${s.whatsapp}`} rel="noopener noreferrer">
                    +{s.whatsapp}
                  </a>
                ) : (
                  <span>
                    <Badge variant="secondary">{t.toBeUpdated}</Badge>
                  </span>
                )}
              </li>
              <li>
                <span>{t.footer.email}</span>
                {s.email ? (
                  <a href={`mailto:${s.email}`}>{s.email}</a>
                ) : (
                  <span>
                    <Badge variant="secondary">{t.toBeUpdated}</Badge>
                  </span>
                )}
              </li>
              <li>
                <span>{t.footer.phone}</span>
                {s.phone ? (
                  <a href={phoneHref}>{s.phone}</a>
                ) : (
                  <span>
                    <Badge variant="secondary">{t.toBeUpdated}</Badge>
                  </span>
                )}
              </li>
              {s.instagram && (
                <li>
                  <a href={s.instagram} rel="noopener noreferrer">
                    Instagram
                  </a>
                </li>
              )}
              {s.linkedin && (
                <li>
                  <a href={s.linkedin} rel="noopener noreferrer">
                    LinkedIn
                  </a>
                </li>
              )}
            </ul>
          </div>
          <div>
            <h2>{t.footer.office}</h2>
            {s.address ? (
              <p class="footer-address">{s.address}</p>
            ) : (
              <Badge variant="secondary">{t.toBeUpdated}</Badge>
            )}
          </div>
        </div>
        <Separator className="mt-14" />
        <div class="footer-bottom">
          <span>{`© ${new Date().getFullYear()} ${s.legalName}`}</span>
          <span>{s.tagline}</span>
        </div>
      </div>
    </footer>
    <script>
      import { mountScrollMotion } from '../scripts/scroll-motion';
      const dispose = mountScrollMotion();
      if (import.meta.hot) import.meta.hot.dispose(dispose);
    </script>
  </body>
</html>
