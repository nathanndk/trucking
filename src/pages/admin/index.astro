---
import AdminLayout from '../../layouts/AdminLayout.astro';
import {
  Card,
  CardAction,
  CardContent,
  CardDescription,
  CardHeader,
  CardTitle,
} from '../../components/ui/card';
import { Badge } from '../../components/ui/badge';
import { buttonVariants } from '../../components/ui/button';
import {
  Empty,
  EmptyDescription,
  EmptyHeader,
  EmptyMedia,
  EmptyTitle,
} from '../../components/ui/empty';
import {
  Item,
  ItemActions,
  ItemContent,
  ItemDescription,
  ItemGroup,
  ItemSeparator,
  ItemTitle,
} from '../../components/ui/item';
import { ArrowUpRight, Package, Newspaper, FolderKanban, Building2, Inbox } from 'lucide-react';
import { db } from '../../db';
import { inquiries } from '../../db/schema';
import { desc, count, eq } from 'drizzle-orm';
import { tables } from '../../lib/repository';
const counts = [
  { name: 'Services', key: 'services', Icon: Package },
  { name: 'Projects', key: 'projects', Icon: FolderKanban },
  { name: 'Clients', key: 'clients', Icon: Building2 },
  { name: 'Articles', key: 'articles', Icon: Newspaper },
].map((i) => ({
  ...i,
  count: db
    .select({ value: count() })
    .from(tables[i.key as keyof typeof tables])
    .get()!.value,
}));
const newCount = db
  .select({ value: count() })
  .from(inquiries)
  .where(eq(inquiries.status, 'new'))
  .get()!.value;
const latest = db.select().from(inquiries).orderBy(desc(inquiries.createdAt)).limit(5).all();
---

<AdminLayout
  title="Overview"
  description="Your website at a glance. Keep content fresh and follow up on new requests."
>
  <div class="mb-8 grid gap-4 sm:grid-cols-2 xl:grid-cols-5">
    {[...counts, { name: 'New inquiries', key: 'inquiries', Icon: Inbox, count: newCount }].map(
      ({ name, key, Icon, count: n }) => (
        <a href={`/admin/${key}`} class="rounded-xl">
          <Card className="h-full gap-2">
            <CardHeader>
              <CardDescription>{name}</CardDescription>
              <CardAction>
                <Icon className="size-4 text-muted-foreground" />
              </CardAction>
            </CardHeader>
            <CardContent>
              <p class="text-3xl font-semibold tracking-tight">{n}</p>
            </CardContent>
          </Card>
        </a>
      ),
    )}
  </div>
  <div class="grid gap-6 xl:grid-cols-[1.5fr_1fr]">
    <Card>
      <CardHeader>
        <CardTitle>Recent inquiries</CardTitle>
        <CardAction>
          <a href="/admin/inquiries" class={buttonVariants({ variant: 'link', size: 'sm' })}>
            View all
          </a>
        </CardAction>
      </CardHeader>
      <CardContent>
        {latest.length ? (
          <ItemGroup>
            {latest.map((item, i) => (
              <>
                {i > 0 && <ItemSeparator />}
                <Item size="sm" className="px-0">
                  <ItemContent>
                    <ItemTitle>{item.fullName}</ItemTitle>
                    <ItemDescription>
                      {item.pickup} → {item.destination}
                      {item.containerType && ` (${item.containerType})`}
                    </ItemDescription>
                  </ItemContent>
                  <ItemActions>
                    <Badge variant={item.status === 'new' ? 'default' : 'secondary'}>
                      {item.status}
                    </Badge>
                  </ItemActions>
                </Item>
              </>
            ))}
          </ItemGroup>
        ) : (
          <Empty className="border">
            <EmptyHeader>
              <EmptyMedia variant="icon">
                <Inbox />
              </EmptyMedia>
              <EmptyTitle>Ready for your next opportunity</EmptyTitle>
              <EmptyDescription>
                Quotation requests from your contact page will appear here.
              </EmptyDescription>
            </EmptyHeader>
          </Empty>
        )}
      </CardContent>
    </Card>
    <Card>
      <CardHeader>
        <CardTitle>Quick actions</CardTitle>
      </CardHeader>
      <CardContent className="flex flex-col gap-3">
        {[
          ['/admin/services', 'Update your services'],
          ['/admin/articles', 'Publish an article'],
          ['/admin/settings', 'Edit company details'],
          ['/', 'Visit public website'],
        ].map(([href, text]) => (
          <a
            href={href}
            class={buttonVariants({ variant: 'outline', className: 'justify-between' })}
          >
            {text}
            <ArrowUpRight className="size-4" />
          </a>
        ))}
      </CardContent>
    </Card>
  </div>
</AdminLayout>
