---
import { desc } from 'drizzle-orm';
import { Check, Circle, Inbox } from 'lucide-react';
import AdminLayout from '../../layouts/AdminLayout.astro';
import RequestsChart from '../../components/admin/RequestsChart';
import { Pill } from '../../components/kibo-ui/pill';
import { buttonVariants } from '../../components/ui/button';
import {
  Card,
  CardAction,
  CardContent,
  CardDescription,
  CardHeader,
  CardTitle,
} from '../../components/ui/card';
import {
  Empty,
  EmptyDescription,
  EmptyHeader,
  EmptyMedia,
  EmptyTitle,
} from '../../components/ui/empty';
import {
  Item,
  ItemActions,
  ItemContent,
  ItemDescription,
  ItemGroup,
  ItemMedia,
  ItemSeparator,
  ItemTitle,
} from '../../components/ui/item';
import { Progress } from '../../components/ui/progress';
import { db } from '../../db';
import { inquiries } from '../../db/schema';
import { contentConfig, type Collection } from '../../lib/content-config';
import {
  containerSplit,
  inquiryStatuses,
  statusCounts,
  statusLabels,
  websiteChecklist,
  weeklyRequests,
} from '../../lib/dashboard';
import { getSettings, listContent } from '../../lib/repository';
import { mailReady } from '../../lib/mail';
import { cn } from '../../lib/utils';

const requests = db.select().from(inquiries).orderBy(desc(inquiries.createdAt)).all();
const byStatus = statusCounts(requests);
const weekly = weeklyRequests(requests);
const containers = containerSplit(requests);
const latest = requests.slice(0, 5);

const collections: Collection[] = ['services', 'projects', 'clients', 'articles'];
const content = collections.map((collection) => {
  const items = listContent(collection);
  return {
    collection,
    label: contentConfig[collection].label,
    singular: contentConfig[collection].singular,
    published: items.filter((item) => item.published).length,
    drafts: items.filter((item) => !item.published).length,
    items,
  };
});
const published = (collection: Collection) =>
  content.find((entry) => entry.collection === collection)!.published;
const checklist = websiteChecklist(
  getSettings(),
  {
    projects: published('projects'),
    clients: published('clients'),
    articles: published('articles'),
    servicesWithoutEnglish: content[0].items.filter(
      (item) => item.published && (!item.titleEn.trim() || !item.descriptionEn.trim()),
    ).length,
  },
  { mailReady: mailReady() },
);
const todo = checklist.filter((item) => !item.done);
const done = checklist.length - todo.length;

const plural = (n: number, one: string, many: string) => `${n} ${n === 1 ? one : many}`;
const summary = [
  byStatus.new
    ? `${plural(byStatus.new, 'new quote request is', 'new quote requests are')} waiting for a reply.`
    : 'No quote requests are waiting.',
  todo.length
    ? `${plural(todo.length, 'detail is', 'details are')} still missing from the website.`
    : 'The website has everything it needs.',
].join(' ');
const received = (date: Date) =>
  date.toLocaleDateString('en-GB', { day: 'numeric', month: 'short', timeZone: 'Asia/Jakarta' });
const link = cn(buttonVariants({ variant: 'link', size: 'sm' }), 'h-auto p-0');
---

<AdminLayout title="Overview" description={summary}>
  <div class="grid gap-6 xl:grid-cols-3">
    <Card className="xl:col-span-2">
      <CardHeader>
        <CardTitle>Quote requests</CardTitle>
        <CardDescription>
          {requests.length
            ? `${plural(requests.length, 'request', 'requests')} so far, by where each one stands.`
            : 'Requests sent from the website’s quote form appear here.'}
        </CardDescription>
        <CardAction>
          <a href="/admin/inquiries" class={buttonVariants({ variant: 'outline', size: 'sm' })}>
            Open board
          </a>
        </CardAction>
      </CardHeader>
      <CardContent className="flex flex-col gap-8">
        {/* A request moves through these four stops in order, like a shipment on the public site's route line. */}
        <ol class="relative grid grid-cols-4 gap-3" aria-label="Requests by status">
          <span class="absolute top-[9px] right-0 left-0 h-0.5 bg-border" aria-hidden="true"></span>
          {inquiryStatuses.map((status) => (
            <li class="relative flex flex-col gap-3">
              <span
                class="size-5 rounded-full border-4 border-card ring-1 ring-border"
                style={`background: var(--status-${status})`}
                aria-hidden="true"
              />
              <span class="flex flex-col">
                <span class="admin-title text-3xl tabular-nums">{byStatus[status]}</span>
                <span class="text-sm text-muted-foreground">{statusLabels[status]}</span>
              </span>
            </li>
          ))}
        </ol>
        {requests.length > 0 && (
          <div class="grid gap-8 lg:grid-cols-[1.4fr_1fr]">
            <div class="flex flex-col gap-3">
              <h3 class="text-sm font-medium">Received per week</h3>
              <RequestsChart data={weekly} client:visible />
            </div>
            <div class="flex flex-col gap-3">
              <h3 class="text-sm font-medium">Container size requested</h3>
              {/* Bar lengths follow the real containers: 40 ft is twice 20 ft. */}
              {(['20ft', '40ft'] as const).map((size) => (
                <div class="flex flex-col gap-1.5">
                  <div
                    class="container-bar h-7"
                    style={`width: ${size === '20ft' ? 49.69 : 100}%`}
                    aria-hidden="true"
                  />
                  <span class="text-sm">
                    <span class="font-medium tabular-nums">{containers[size]}</span>
                    <span class="text-muted-foreground">
                      {' '}
                      for {size === '20ft' ? '20' : '40'} ft
                    </span>
                  </span>
                </div>
              ))}
            </div>
          </div>
        )}
      </CardContent>
    </Card>
    <Card className="xl:row-span-2">
      <CardHeader>
        <CardTitle>Website checklist</CardTitle>
        <CardDescription>
          {todo.length
            ? 'Missing details are hidden on the website until filled in.'
            : 'Nothing on the public website is waiting for information.'}
        </CardDescription>
      </CardHeader>
      <CardContent className="flex flex-col gap-5">
        <div class="flex flex-col gap-2">
          <Progress
            value={(done / checklist.length) * 100}
            aria-label="Website checklist progress"
          />
          <span class="text-sm text-muted-foreground">
            <span class="font-medium text-foreground tabular-nums">{done}</span> of{' '}
            {checklist.length} complete
          </span>
        </div>
        <ItemGroup>
          {[...todo, ...checklist.filter((item) => item.done)].map((item, i) => (
            <>
              {i > 0 && <ItemSeparator />}
              <Item size="sm" className="px-0">
                <ItemMedia>
                  {item.done ? (
                    <Check className="size-4 text-[var(--mint)]" aria-label="Done" />
                  ) : (
                    <Circle className="size-4 text-muted-foreground" aria-label="Missing" />
                  )}
                </ItemMedia>
                <ItemContent>
                  <ItemTitle className={item.done ? 'font-normal text-muted-foreground' : ''}>
                    {item.label}
                  </ItemTitle>
                </ItemContent>
                {!item.done &&
                  (item.href ? (
                    <ItemActions>
                      <a
                        href={item.href}
                        class={buttonVariants({ variant: 'outline', size: 'xs' })}
                        aria-label={`${item.label}: open ${item.where}`}
                      >
                        {item.where}
                      </a>
                    </ItemActions>
                  ) : (
                    <ItemDescription className="line-clamp-none">{item.where}</ItemDescription>
                  ))}
              </Item>
            </>
          ))}
        </ItemGroup>
      </CardContent>
    </Card>
    <Card>
      <CardHeader>
        <CardTitle>Latest requests</CardTitle>
        <CardAction>
          <a href="/admin/inquiries" class={link}>
            View all
          </a>
        </CardAction>
      </CardHeader>
      <CardContent>
        {latest.length ? (
          <ItemGroup>
            {latest.map((item, i) => (
              <>
                {i > 0 && <ItemSeparator />}
                <Item size="sm" className="px-0">
                  <ItemContent>
                    <ItemTitle>{item.fullName}</ItemTitle>
                    <ItemDescription>
                      {item.pickup} to {item.destination}
                      {item.containerType && `, ${item.containerType}`}
                    </ItemDescription>
                  </ItemContent>
                  <ItemActions className="flex-col items-end gap-1">
                    <Pill variant="outline" className="px-2 py-0.5">
                      <span
                        class="size-2 rounded-full"
                        style={`background: var(--status-${item.status})`}
                        aria-hidden="true"
                      />
                      {statusLabels[item.status]}
                    </Pill>
                    <span class="text-xs text-muted-foreground">{received(item.createdAt)}</span>
                  </ItemActions>
                </Item>
              </>
            ))}
          </ItemGroup>
        ) : (
          <Empty className="border md:p-8">
            <EmptyHeader>
              <EmptyMedia variant="icon">
                <Inbox />
              </EmptyMedia>
              <EmptyTitle className="text-base">No requests yet</EmptyTitle>
              <EmptyDescription>
                The first request from the quote form will show up here.
              </EmptyDescription>
            </EmptyHeader>
          </Empty>
        )}
      </CardContent>
    </Card>
    <Card>
      <CardHeader>
        <CardTitle>Content</CardTitle>
        <CardDescription>What is published on the website now.</CardDescription>
      </CardHeader>
      <CardContent>
        <ItemGroup>
          {content.map((entry, i) => (
            <>
              {i > 0 && <ItemSeparator />}
              <Item size="sm" className="px-0">
                <ItemContent>
                  <ItemTitle>{entry.label}</ItemTitle>
                  <ItemDescription>
                    {entry.published + entry.drafts === 0
                      ? 'None yet'
                      : [
                          `${entry.published} published`,
                          entry.drafts ? plural(entry.drafts, 'draft', 'drafts') : '',
                        ]
                          .filter(Boolean)
                          .join(', ')}
                  </ItemDescription>
                </ItemContent>
                <ItemActions>
                  <a
                    href={`/admin/${entry.collection}`}
                    class={buttonVariants({ variant: 'outline', size: 'xs' })}
                    aria-label={`Manage ${entry.label.toLowerCase()}`}
                  >
                    Manage
                  </a>
                </ItemActions>
              </Item>
            </>
          ))}
        </ItemGroup>
      </CardContent>
    </Card>
  </div>
</AdminLayout>
