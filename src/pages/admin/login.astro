---
import '../../styles/global.css';
import Login from '../../components/admin/Login';
import { buttonVariants } from '../../components/ui/button';
import {
  Card,
  CardContent,
  CardDescription,
  CardHeader,
  CardTitle,
} from '../../components/ui/card';
import { getSettings } from '../../lib/repository';
if (Astro.locals.admin) return Astro.redirect('/admin', 303);
const s = getSettings();
---

<!doctype html>
<html lang="en" translate="no">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="google" content="notranslate" />
    <meta name="robots" content="noindex,nofollow" />
    <title>Admin sign in · {s.companyName}</title>
    <link rel="icon" href={s.favicon || '/favicon.png'} />
  </head>
  <body class="min-h-screen bg-muted">
    <main class="grid min-h-screen lg:grid-cols-2">
      <section class="dark relative hidden overflow-hidden bg-background p-16 text-white lg:flex lg:flex-col lg:justify-between">
        <img
          src="/images/genesis/hero-port-1280.webp"
          alt=""
          class="absolute inset-0 h-full w-full object-cover opacity-25"
        />
        <div class="relative">
          <span class="text-sm font-semibold text-[#7cc3a2]">{s.companyName} website admin</span>
        </div>
        <div class="relative">
          <h1 class="text-5xl font-semibold leading-tight tracking-tight">
            Keep your business
            <br />
            moving forward.
          </h1>
          <p class="mt-6 max-w-sm text-sm leading-relaxed text-white/80">
            One place for your website content, articles, and new quotation requests.
          </p>
        </div>
        <p class="relative text-xs text-white/70">
          Private access · Authorized administrators only
        </p>
      </section>
      <section class="flex items-center justify-center overflow-hidden px-6 py-16">
        {/* Dashed guide lines frame the form, like the lines painted on a container yard. */}
        <div class="relative w-full max-w-sm">
          <span
            class="pointer-events-none absolute -inset-x-[100vw] -top-px border-t border-dashed border-border"
            aria-hidden="true"
          ></span>
          <span
            class="pointer-events-none absolute -inset-x-[100vw] -bottom-px border-t border-dashed border-border"
            aria-hidden="true"
          ></span>
          <span
            class="pointer-events-none absolute -inset-y-[100vh] -left-px border-l border-dashed border-border"
            aria-hidden="true"
          ></span>
          <span
            class="pointer-events-none absolute -inset-y-[100vh] -right-px border-l border-dashed border-border"
            aria-hidden="true"
          ></span>
          <div class="flex flex-col gap-6 p-6">
            <div class="flex items-center gap-3">
              <img src={s.favicon || '/favicon.png'} alt="" class="size-10" />
              <div class="grid leading-tight">
                <span class="admin-title text-lg">{s.companyName}</span>
                <span class="text-sm text-muted-foreground">Website admin</span>
              </div>
            </div>
            <Card>
              <CardHeader>
                <CardTitle>
                  <h2 class="text-xl">Welcome back.</h2>
                </CardTitle>
                <CardDescription>Sign in to manage your website.</CardDescription>
              </CardHeader>
              <CardContent>
                <Login client:load />
              </CardContent>
            </Card>
            <a href="/" class={buttonVariants({ variant: 'link', size: 'sm' })}>
              Back to website
            </a>
          </div>
        </div>
      </section>
    </main>
  </body>
</html>
