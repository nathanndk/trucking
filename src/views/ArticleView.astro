---
import PublicLayout from '../layouts/PublicLayout.astro';
import CTA from '../components/marketing/CTA.astro';
import { AspectRatio } from '../components/ui/aspect-ratio';
import {
  Breadcrumb,
  BreadcrumbItem,
  BreadcrumbLink,
  BreadcrumbList,
  BreadcrumbPage,
  BreadcrumbSeparator,
} from '../components/ui/breadcrumb';
import { Separator } from '../components/ui/separator';
import type { ContentRecord } from '../lib/content-config';
import { getPublicSettings } from '../lib/repository';
import { formatDate, localePath, toLocale } from '../i18n';
import { ui } from '../lib/copy';
interface Props {
  article: ContentRecord;
}
const { article } = Astro.props;
const locale = toLocale(Astro.currentLocale);
const t = ui(locale);
const s = getPublicSettings(locale);
// Article bodies are plain text. Blank lines separate paragraphs; Astro escapes the content.
const paragraphs = article.description
  .split(/\n{2,}/)
  .map((paragraph) => paragraph.trim())
  .filter(Boolean);
const summary = article.shortDescription || paragraphs[0]?.slice(0, 160) || t.articles.intro;
---

<PublicLayout title={article.title} description={summary} image={article.image || undefined}>
  <section class="section">
    <div class="wrap">
      <article class="article">
        <Breadcrumb>
          <BreadcrumbList>
            <BreadcrumbItem>
              <BreadcrumbLink href={localePath(locale, '/articles')}>
                {t.articles.back}
              </BreadcrumbLink>
            </BreadcrumbItem>
            <BreadcrumbSeparator />
            <BreadcrumbItem>
              <BreadcrumbPage>{article.title}</BreadcrumbPage>
            </BreadcrumbItem>
          </BreadcrumbList>
        </Breadcrumb>
        <h1 class="mt-6">{article.title}</h1>
        <p class="mt-4 text-sm text-muted-foreground">
          <time datetime={article.createdAt.toISOString()}>
            {formatDate(article.createdAt, locale)}
          </time>
        </p>
        {article.image ? (
          <AspectRatio ratio={16 / 9} className="my-8 overflow-hidden rounded-lg bg-muted">
            <img class="photo" src={article.image} alt="" width="1280" height="720" />
          </AspectRatio>
        ) : (
          <Separator className="my-8" />
        )}
        <div class="article-body">
          {paragraphs.map((paragraph) => (
            <p>{paragraph}</p>
          ))}
        </div>
      </article>
    </div>
  </section>
  <CTA text={s.ctaText} />
</PublicLayout>
