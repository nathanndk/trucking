---
import PublicLayout from '../layouts/PublicLayout.astro';
import CTA from '../components/marketing/CTA.astro';
import ArticleIndex from '../components/marketing/ArticleIndex.astro';
import DateMark from '../components/marketing/DateMark.astro';
import {
  Breadcrumb,
  BreadcrumbItem,
  BreadcrumbLink,
  BreadcrumbList,
  BreadcrumbPage,
  BreadcrumbSeparator,
} from '../components/ui/breadcrumb';
import type { ContentRecord } from '../lib/content-config';
import { getPublicContent, getPublicSettings } from '../lib/repository';
import { localePath, toLocale } from '../i18n';
import { ui } from '../lib/copy';
import { responsive } from '../lib/images';
interface Props {
  article: ContentRecord;
}
const { article } = Astro.props;
const locale = toLocale(Astro.currentLocale);
const t = ui(locale);
const s = getPublicSettings(locale);
// Article bodies are plain text. Blank lines separate paragraphs; Astro escapes the content.
const paragraphs = article.description
  .split(/\n{2,}/)
  .map((paragraph) => paragraph.trim())
  .filter(Boolean);
const summary = article.shortDescription || paragraphs[0]?.slice(0, 160) || t.articles.intro;
const others = getPublicContent('articles', locale)
  .filter((other) => other.slug !== article.slug)
  .slice(0, 3);
---

<PublicLayout title={article.title} description={summary} image={article.image || undefined}>
  <section class="section article-page">
    <div class="wrap">
      <Breadcrumb>
        <BreadcrumbList>
          <BreadcrumbItem>
            <BreadcrumbLink href={localePath(locale, '/articles')}>
              {t.articles.back}
            </BreadcrumbLink>
          </BreadcrumbItem>
          <BreadcrumbSeparator />
          <BreadcrumbItem>
            <BreadcrumbPage>{article.title}</BreadcrumbPage>
          </BreadcrumbItem>
        </BreadcrumbList>
      </Breadcrumb>
      <article class="article">
        <header class="article-head">
          <DateMark date={article.createdAt} />
          <div>
            <h1>{article.title}</h1>
            {article.shortDescription && <p class="article-summary">{article.shortDescription}</p>}
          </div>
        </header>
        {article.image && (
          <div class="article-photo">
            <img
              class="photo"
              {...responsive(article.image, '(max-width: 1240px) 100vw, 1200px')}
              alt=""
              width="1280"
              height="720"
            />
          </div>
        )}
        <div class="article-body">
          {paragraphs.map((paragraph) => (
            <p>{paragraph}</p>
          ))}
        </div>
      </article>
    </div>
  </section>
  {others.length > 0 && (
    <section class="section tint">
      <div class="wrap">
        <h2 class="mb-8">{t.articles.more}</h2>
        <ArticleIndex items={others} />
      </div>
    </section>
  )}
  <CTA text={s.ctaText} />
</PublicLayout>
