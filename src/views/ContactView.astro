---
import { actions, isInputError } from 'astro:actions';
import type { ActionError } from 'astro:actions';
import PublicLayout from '../layouts/PublicLayout.astro';
import PageHero from '../components/marketing/PageHero.astro';
import QuoteForm from '../components/site/QuoteForm';
import { Alert, AlertDescription, AlertTitle } from '../components/ui/alert';
import { Badge } from '../components/ui/badge';
import { Card, CardContent, CardDescription, CardHeader, CardTitle } from '../components/ui/card';
import {
  Item,
  ItemContent,
  ItemDescription,
  ItemGroup,
  ItemSeparator,
  ItemTitle,
} from '../components/ui/item';
import { getPublicContent, getPublicSettings } from '../lib/repository';
import { formToken } from '../lib/spam';
import { containerTypes } from '../lib/validation';
import { toLocale } from '../i18n';
import { ui } from '../lib/copy';
interface Props {
  /** Error from a submitted quote, passed down by the route file. */
  error?: ActionError;
}
const { error } = Astro.props;
const locale = toLocale(Astro.currentLocale);
const t = ui(locale);
const c = t.contact;
const s = getPublicSettings(locale);
const services = getPublicContent('services', locale);
const success = Astro.url.searchParams.get('sent') === '1';
const errorText = !error
  ? ''
  : isInputError(error)
    ? c.errors.invalid
    : (c.errors[error.code as keyof typeof c.errors] ?? c.errors.generic);
const contacts = [
  {
    label: c.whatsapp,
    value: s.whatsapp && `+${s.whatsapp}`,
    href: s.whatsapp && `https://wa.me/${s.whatsapp}`,
  },
  { label: c.phone, value: s.phone, href: s.phone && `tel:${s.phone.replace(/[^+\d]/g, '')}` },
  { label: c.email, value: s.email, href: s.email && `mailto:${s.email}` },
  { label: c.office, value: s.address, href: '' },
];
---

<PublicLayout title={c.title} description={c.description}>
  <PageHero label={t.nav.contact} title={c.h1} description={c.intro} />
  <section class="section">
    <div class="wrap contact-grid">
      <aside>
        <h2 class="mb-4">{c.infoHeading}</h2>
        <ItemGroup>
          {contacts.map((contact, i) => (
            <>
              {i > 0 && <ItemSeparator />}
              <Item className="px-0">
                <ItemContent>
                  <ItemDescription>{contact.label}</ItemDescription>
                  <ItemTitle className="text-base font-semibold break-all whitespace-pre-line">
                    {!contact.value ? (
                      <Badge variant="secondary">{t.toBeUpdated}</Badge>
                    ) : contact.href ? (
                      <a
                        class="text-primary hover:underline hover:underline-offset-4"
                        href={contact.href}
                        rel="noopener noreferrer"
                      >
                        {contact.value}
                      </a>
                    ) : (
                      contact.value
                    )}
                  </ItemTitle>
                  {contact.label === c.office && s.mapsUrl && (
                    <ItemDescription>
                      <a href={s.mapsUrl} rel="noopener noreferrer">
                        {c.maps}
                      </a>
                    </ItemDescription>
                  )}
                </ItemContent>
              </Item>
            </>
          ))}
        </ItemGroup>
      </aside>
      <Card>
        <CardHeader>
          <CardTitle>
            <h2 class="text-2xl">{c.formHeading}</h2>
          </CardTitle>
          <CardDescription>{c.required}</CardDescription>
        </CardHeader>
        <CardContent className="flex flex-col gap-6">
          {success && (
            <Alert role="status">
              <AlertTitle>{c.successTitle}</AlertTitle>
              <AlertDescription>{c.successText}</AlertDescription>
            </Alert>
          )}
          {errorText && (
            <Alert variant="destructive">
              <AlertDescription>{errorText}</AlertDescription>
            </Alert>
          )}
          <QuoteForm
            client:load
            action={actions.quote.toString()}
            token={formToken()}
            services={services.map(({ slug, title }) => ({ slug, title }))}
            containers={containerTypes.map((value) => ({
              value,
              name: t.container.sizes[value].name,
              detail: `${t.container.lengthLabel} ${t.container.sizes[value].length}`,
            }))}
            selectedService={Astro.url.searchParams.get('service') || ''}
            selectedContainer={Astro.url.searchParams.get('container') || ''}
            labels={{
              fullName: c.fullName,
              company: c.company,
              phoneField: c.phoneField,
              emailField: c.emailField,
              serviceType: c.serviceType,
              servicePlaceholder: c.servicePlaceholder,
              pickup: c.pickup,
              destination: c.destination,
              containerType: c.containerType,
              message: c.message,
              messagePlaceholder: c.messagePlaceholder,
              privacy: c.privacy,
              submit: c.submit,
            }}
          />
        </CardContent>
      </Card>
    </div>
  </section>
</PublicLayout>
