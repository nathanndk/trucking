---
import PublicLayout from '../layouts/PublicLayout.astro';
import RouteLine from '../components/marketing/RouteLine.astro';
import ContainerScale from '../components/marketing/ContainerScale.astro';
import ServiceGrid from '../components/marketing/ServiceGrid.astro';
import ProjectGrid from '../components/marketing/ProjectGrid.astro';
import ArticleList from '../components/marketing/ArticleList.astro';
import CTA from '../components/marketing/CTA.astro';
import { getPublicContent, getPublicSettings } from '../lib/repository';
import { localePath, toLocale, ui } from '../i18n';
const locale = toLocale(Astro.currentLocale);
const t = ui(locale);
const s = getPublicSettings(locale);
const href = (path: string) => localePath(locale, path);
const services = getPublicContent('services', locale);
const projects = getPublicContent('projects', locale).slice(0, 2);
const clients = getPublicContent('clients', locale);
const articles = getPublicContent('articles', locale).slice(0, 3);
const aboutLead = s.about.split(/\n{2,}/)[0];
---

<PublicLayout title={t.home.title} description={s.shortDescription}>
  <section class="hero" data-motion="hero">
    <div class="hero-media">
      <img
        class="hero-photo"
        src="/images/genesis/hero-port-1920.webp"
        srcset="/images/genesis/hero-port-768.webp 768w, /images/genesis/hero-port-1280.webp 1280w, /images/genesis/hero-port-1920.webp 1920w"
        sizes="100vw"
        alt={t.home.heroAlt}
        width="1920"
        height="1080"
        fetchpriority="high"
      />
    </div>
    <div class="wrap hero-content">
      <div class="hero-copy">
        <p class="hero-tagline">{s.tagline}</p>
        <h1>{t.home.h1}</h1>
        <p class="hero-text">{s.shortDescription}</p>
        <div class="hero-actions">
          <a href={href('/contact')} class="cta">
            {s.ctaText}
          </a>
          <a href={href('/services')} class="cta line">
            {t.home.servicesLink}
          </a>
        </div>
      </div>
    </div>
  </section>
  <RouteLine />
  <section class="section">
    <div class="wrap intro-grid">
      <div class="intro-copy">
        <h2 data-motion="heading">{t.home.aboutHeading}</h2>
        <p data-motion="copy">{aboutLead}</p>
        <a class="text-link" href={href('/about')}>
          {t.home.aboutLink}
        </a>
      </div>
      <img
        class="photo"
        src="/images/genesis/about-handshake-1280.webp"
        srcset="/images/genesis/about-handshake-640.webp 640w, /images/genesis/about-handshake-1280.webp 1280w"
        sizes="(max-width: 800px) 100vw, 50vw"
        alt={t.home.aboutAlt}
        width="1280"
        height="720"
        loading="lazy"
      />
    </div>
  </section>
  <section class="section tint">
    <div class="wrap split-list">
      <h2 data-motion="heading">{t.strengths.heading}</h2>
      <ul class="ruled">
        {t.strengths.items.map((item) => (
          <li>
            <span class="ruled-title">{item.title}</span>
            <span class="ruled-text">{item.text}</span>
          </li>
        ))}
      </ul>
    </div>
  </section>
  <section class="section" id="services">
    <div class="wrap">
      <div class="section-head">
        <h2 data-motion="heading">{t.home.servicesHeading}</h2>
        <a href={href('/services')} class="text-link">
          {t.home.servicesAll}
        </a>
      </div>
      <ServiceGrid items={services} />
    </div>
  </section>
  <ContainerScale />
  <section class="section tint">
    <div class="wrap split-list">
      <h2 data-motion="heading">{t.area.heading}</h2>
      <dl class="ruled">
        <div>
          <dt>{t.area.main}</dt>
          <dd>{t.area.mainValue}</dd>
        </div>
        <div>
          <dt>{t.area.port}</dt>
          <dd>{t.area.portValue}</dd>
        </div>
        <div>
          <dt>{t.area.other}</dt>
          <dd>
            <span class="marker">{t.toBeUpdated}</span>
          </dd>
        </div>
      </dl>
    </div>
  </section>
  <section class="section">
    <div class="wrap">
      <div class="section-head">
        <h2 data-motion="heading">{t.home.projectsHeading}</h2>
        <a href={href('/projects')} class="text-link">
          {t.home.projectsLink}
        </a>
      </div>
      {projects.length > 0 && <ProjectGrid items={projects} />}
      {clients.length > 0 && (
        <div class="client-grid" style={projects.length ? 'margin-top:40px' : undefined}>
          {clients.map((client) => (
            <div>
              {client.image ? (
                <img src={client.image} alt={client.title} width="240" height="80" loading="lazy" />
              ) : (
                client.title
              )}
            </div>
          ))}
        </div>
      )}
      {projects.length === 0 && clients.length === 0 && (
        <p class="placeholder">
          {t.home.projectsEmpty}
          <span class="marker">{t.toBeUpdated}</span>
        </p>
      )}
    </div>
  </section>
  <section class="section tint">
    <div class="wrap">
      <div class="section-head">
        <h2 data-motion="heading">{t.home.articlesHeading}</h2>
        <a href={href('/articles')} class="text-link">
          {t.home.articlesLink}
        </a>
      </div>
      {articles.length > 0 ? (
        <ArticleList items={articles} />
      ) : (
        <p class="placeholder">
          {t.home.articlesEmpty}
          <span class="marker">{t.toBeUpdated}</span>
        </p>
      )}
    </div>
  </section>
  <CTA text={s.ctaText} />
</PublicLayout>
