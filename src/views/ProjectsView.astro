---
import PublicLayout from '../layouts/PublicLayout.astro';
import PageHero from '../components/marketing/PageHero.astro';
import ProjectGrid from '../components/marketing/ProjectGrid.astro';
import Placeholder from '../components/marketing/Placeholder.astro';
import CTA from '../components/marketing/CTA.astro';
import { Card, CardContent } from '../components/ui/card';
import { getPublicContent, getPublicSettings } from '../lib/repository';
import { fill, toLocale } from '../i18n';
import { ui } from '../lib/copy';
const locale = toLocale(Astro.currentLocale);
const t = ui(locale);
const s = getPublicSettings(locale);
const projects = getPublicContent('projects', locale);
const clients = getPublicContent('clients', locale);
---

<PublicLayout
  title={t.projects.title}
  description={fill(t.projects.description, { name: s.legalName })}
>
  <PageHero label={t.nav.projects} title={t.projects.h1} description={t.projects.intro} />
  <section class="section">
    <div class="wrap">
      <h2 class="mb-8">{t.projects.projectsHeading}</h2>
      {projects.length > 0 ? (
        <ProjectGrid items={projects} full />
      ) : (
        <Placeholder text={t.projects.projectsEmpty} />
      )}
    </div>
  </section>
  <section class="section tint">
    <div class="wrap">
      <h2 data-motion="heading" class="mb-8">
        {t.projects.clientsHeading}
      </h2>
      {clients.length > 0 ? (
        <div class="client-grid">
          {clients.map((client) => {
            const mark = client.image ? (
              <img src={client.image} alt={client.title} width="240" height="80" loading="lazy" />
            ) : (
              client.title
            );
            return (
              <Card className="justify-center py-5">
                <CardContent className="flex min-h-16 items-center justify-center text-center font-semibold">
                  {client.website ? (
                    <a href={client.website} rel="noopener noreferrer">
                      {mark}
                    </a>
                  ) : (
                    mark
                  )}
                </CardContent>
              </Card>
            );
          })}
        </div>
      ) : (
        <Placeholder text={t.projects.clientsEmpty} />
      )}
    </div>
  </section>
  <CTA text={s.ctaText} />
</PublicLayout>
