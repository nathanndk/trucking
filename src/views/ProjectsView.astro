---
import PublicLayout from '../layouts/PublicLayout.astro';
import PageHero from '../components/marketing/PageHero.astro';
import CTA from '../components/marketing/CTA.astro';
import { getPublicContent, getPublicSettings } from '../lib/repository';
import { fill, toLocale } from '../i18n';
import { ui } from '../lib/copy';
const locale = toLocale(Astro.currentLocale);
const t = ui(locale);
const s = getPublicSettings(locale);
const projects = getPublicContent('projects', locale);
const clients = getPublicContent('clients', locale);
// Projects read as a ledger of shipments: each entry opens with its year, set wide like the
// markings on a container door, and the client the goods were moved for.
---

<PublicLayout
  title={t.projects.title}
  description={fill(t.projects.description, { name: s.legalName })}
>
  <PageHero label={t.nav.projects} title={t.projects.h1} description={t.projects.intro} />
  {projects.length > 0 && (
    <section class="section">
      <div class="wrap">
        <h2 class="mb-10">{t.projects.projectsHeading}</h2>
        <ol class="ledger">
          {projects.map((project) => (
            <li class="ledger-entry" id={project.slug}>
              <div class="ledger-head">
                {project.projectYear && <span class="ledger-year">{project.projectYear}</span>}
                {project.clientName && <span class="ledger-client">{project.clientName}</span>}
              </div>
              <div class:list={['ledger-body', !project.image && 'ledger-body-text']}>
                {project.image && (
                  <div class="ledger-photo">
                    <img
                      class="photo"
                      src={project.image}
                      alt={fill(t.projects.imageAlt, { title: project.title })}
                      width="1280"
                      height="800"
                      loading="lazy"
                    />
                  </div>
                )}
                <div class="ledger-copy">
                  <h3>{project.title}</h3>
                  <p>{project.description || project.shortDescription}</p>
                </div>
              </div>
            </li>
          ))}
        </ol>
      </div>
    </section>
  )}
  {clients.length > 0 && (
    <section class="section tint">
      <div class="wrap">
        <h2 data-motion="heading" class="mb-8">
          {t.projects.clientsHeading}
        </h2>
        <ul class="client-list">
          {clients.map((client) => {
            const mark = client.image ? (
              <img src={client.image} alt={client.title} width="240" height="80" loading="lazy" />
            ) : (
              client.title
            );
            return (
              <li>
                {client.website ? (
                  <a href={client.website} rel="noopener noreferrer">
                    {mark}
                  </a>
                ) : (
                  mark
                )}
              </li>
            );
          })}
        </ul>
      </div>
    </section>
  )}
  <CTA text={s.ctaText} />
</PublicLayout>
